# Server/CLI default. Keep credentials out of endpoint URLs.
OLLAMA_BASE_URL=http://localhost:11434
# Milliseconds: generation warning threshold; model-list request abort timeout.
OLLAMA_TIMEOUT=120000
# Optional additional exact URLs approved by the server operator, comma separated.
# OLLAMA_ALLOWED_ENDPOINTS=http://ollama-lan:11434
# Deterministic development/test responses; no inference or output-quality evidence.
# OLLAMA_MOCK=1
# Optional experimental React Three Fiber renderer.
# NEXT_PUBLIC_ENABLE_R3F=1
